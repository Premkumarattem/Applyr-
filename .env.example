# Applyr Configuration

# 1. Email Configuration (Pick either Resend API or SMTP)

# Option A: Resend API (Recommended - works on all cloud hosts including Railway)
# Get a free key at https://resend.com
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=Job Applicant

# Option B: Custom SMTP Server (Gmail / Outlook / SendGrid / Mailgun)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# FROM_EMAIL=your-email@gmail.com
# FROM_NAME=Your Name

# 2. AI Resume Tailoring (Groq LLM)
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Adzuna Job Search API (Get free keys at https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# 4. Hunter.io Email Lookup API (Optional - https://hunter.io)
HUNTER_API_KEY=

# 5. Session Secret
SESSION_SECRET=dev-secret-change-me-in-production
