# Applyr Configuration

# ----------------------------------------------------------------------
# 1. EMAIL OUTREACH CONFIGURATION (Recommended: Resend API)
# ----------------------------------------------------------------------
# WHY USE RESEND API?
# Traditional SMTP ports (587, 465, 25) are often blocked by ISPs, local firewalls, 
# and cloud providers (Railway, Render, AWS), causing "Connection timeout" errors.
# Resend uses standard HTTPS (port 443) REST API which NEVER gets blocked.

# Option A: Resend API (Free 3,000 emails/month at https://resend.com)
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=Job Applicant

# Option B: Gmail SMTP (Requires Gmail App Password: https://myaccount.google.com/apppasswords)
# SMTP_SERVICE=gmail
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# FROM_EMAIL=your-email@gmail.com
# FROM_NAME=Your Name

# Option C: Custom SMTP Server
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=your-username
# SMTP_PASS=your-password

# ----------------------------------------------------------------------
# 2. AI RESUME TAILORING (Groq LLM)
# ----------------------------------------------------------------------
# Free API key at https://console.groq.com/keys (built-in local AI fallback is used if empty)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ----------------------------------------------------------------------
# 3. JOB SEARCH API (Adzuna)
# ----------------------------------------------------------------------
# Free keys at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ----------------------------------------------------------------------
# 4. HUNTER.IO CONTACT LOOKUP (Optional - https://hunter.io)
# ----------------------------------------------------------------------
HUNTER_API_KEY=

# ----------------------------------------------------------------------
# 5. SESSION SECRET
# ----------------------------------------------------------------------
SESSION_SECRET=dev-secret-change-me-in-production
