# --- Adzuna (job search) ---
# Get free keys at https://developer.adzuna.com/
ADZUNA_APP_ID=your_app_id
ADZUNA_APP_KEY=your_app_key

# --- Outreach email ---
# RECOMMENDED: Resend (free tier, HTTPS API — works on every host, including
# Railway's free/hobby plan, which blocks raw SMTP ports entirely).
# Get a free key at https://resend.com/api-keys
RESEND_API_KEY=

# Fallback: plain SMTP (works on Render and most other hosts, but NOT on
# Railway's free/hobby plan — Railway blocks outbound SMTP there).
# Only used if RESEND_API_KEY is not set.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_app_password
FROM_NAME=Your Name
FROM_EMAIL=you@example.com

# --- Optional: Hunter.io for finding a company's likely HR/recruiting email ---
# Get a free key at https://hunter.io/ (leave blank to disable this feature)
HUNTER_API_KEY=

# --- Groq (free-tier AI for resume tailoring) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Server ---
PORT=3000
# A long random string used to sign login session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_random_string
